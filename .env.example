# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋되지 않는다.

# ══ 서버 전용 (VITE_ 접두사 없음 = 브라우저 번들에 안 들어감) ══
# 배포 시 Vercel 대시보드 > Settings > Environment Variables 에 같은 이름으로 등록한다.
#
# 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# 판정·음원 엔드포인트 접근 코드.
# 비워두면 배포 주소를 아는 누구나 호출할 수 있고, 그건 곧 요금이다.
APP_PASSCODE=

# ══ 브라우저에 포함됨 (Firebase 웹 설정 — 원래 공개되는 값) ══
# 실제 접근 통제는 Firestore 보안 규칙이 한다. firestore.rules 참고.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
