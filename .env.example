# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋되지 않는다.
#
# 키 발급: https://aistudio.google.com/apikey
# 주의: Vite의 VITE_ 접두사 변수는 빌드 결과물에 그대로 박힌다.
#       배포하면 브라우저에서 키가 보인다 — 개인용 앱이라 감수하는 것이고,
#       공개 배포로 갈 거면 서버(프록시)를 한 겹 둬야 한다.

VITE_GEMINI_API_KEY=

# 판정용 모델. 무료 티어 Flash 계열 (기획서 6장)
VITE_GEMINI_MODEL=gemini-flash-latest

# 수신훈련 음원용 TTS 모델·목소리.
# TTS 모델은 판정 모델과 별개이고 무료 티어 포함 여부가 다를 수 있다.
# 목소리 예: Kore, Charon, Puck, Aoede, Fenrir
VITE_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
VITE_GEMINI_TTS_VOICE=Kore
